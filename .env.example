# ──────────────────────────────────────────────────────────────
# 학교 식물 탐사대 — 서버 환경변수 (이 파일을 복사해 .env.local 로 저장)
# ──────────────────────────────────────────────────────────────

# 모의 모드: 1 이면 국립수목원·제미나이를 호출하지 않고 samples/ 폴더의 자료로 응답
# (키 없이 화면 흐름 전체를 시연할 때, 연수 중 API 장애 시 사용)
MOCK=0

# 공유 키 허용: 1 이면 사용자가 키를 넣지 않았을 때 아래 서버 키를 대신 사용
# (강사 시연용. 참가자용 배포본에서는 0 으로 두어 각자 키를 넣게 함)
ALLOW_SHARED_KEY=0

# 공공데이터포털 "일반 인증키" (Encoding·Decoding 아무거나) — ALLOW_SHARED_KEY=1 일 때만 사용
# 사용자가 설정 화면에 자기 키를 넣으면 그 키를 먼저 쓴다
DATA_GO_KR_KEY=

# 구글 AI 스튜디오 제미나이 키 — ALLOW_SHARED_KEY=1 일 때만 사용
GEMINI_API_KEY=

# 제미나이 모델 이름 (무료 등급에서 쓸 수 있는 모델인지 AI 스튜디오에서 확인)
GEMINI_MODEL=gemini-2.5-flash
